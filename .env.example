# Copy to .env to override the defaults used by docker-compose.yml.
# Every line is optional.

# Host port the web UI is published on.
QM_PORT=8580

# Time zone for the container's logs.
TZ=America/Phoenix

# Kiosk and admin sessions lock after this many idle minutes.
QM_IDLE_MINUTES=15

# Wrong-PIN lockout per source IP (starting values; the admin site's Settings page can change them):
# after THRESHOLD failures the IP is locked for BASE seconds, doubling with each further failure up to MAX.
QM_LOCKOUT_THRESHOLD=5
QM_LOCKOUT_BASE_SECONDS=60
QM_LOCKOUT_MAX_SECONDS=3600

# Set true behind a reverse proxy: lockouts use the client IP from X-Forwarded-For and the Host the browser used.
QM_TRUST_PROXY=false
# Mark the session cookie Secure (for HTTPS).
QM_COOKIE_SECURE=false

# Pre-fill unknown barcodes from UPCitemdb (only the barcode number is sent).
QM_UPC_LOOKUP=true
