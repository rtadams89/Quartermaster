# Copy to .env to override the defaults used by docker-compose.yml.
# Every line is optional.

# Host port the web UI is published on.
QM_PORT=8580

# Time zone for the container's logs.
TZ=America/Phoenix

# Kiosk and admin sessions lock after this many idle minutes.
QM_IDLE_MINUTES=15

# Wrong-PIN lockout, tracked per source IP (starting values: change them any time in the admin site's
# Settings): after THRESHOLD failures the IP is
# locked for BASE seconds, doubling with each further failure up to MAX.
QM_LOCKOUT_THRESHOLD=5
QM_LOCKOUT_BASE_SECONDS=60
QM_LOCKOUT_MAX_SECONDS=3600

# Behind a reverse proxy? Set TRUST_PROXY=true so lockouts use the real client IP
# from X-Forwarded-For and the Host the browser used. Leave false when browsers connect to the container
# directly. (Either way, the proxy must pass the original Host header through.)
QM_TRUST_PROXY=false
# Serving over HTTPS? Mark the session cookie Secure.
QM_COOKIE_SECURE=false

# Pre-fill unknown barcodes from the free UPCitemdb service (only the barcode number is sent).
# Set false to keep the server fully offline.
QM_UPC_LOOKUP=true
