[Unit]
Description=Quartermaster camera helper (Pi camera module -> kiosk)
After=local-fs.target

[Service]
# Change User to the account that is allowed to use the camera (it needs to be in the "video" group).
User=kiosk
SupplementaryGroups=video
# Set this to the exact address the kiosk loads, so no other website can ask for photos.
Environment=QM_CAMERA_ORIGIN=http://SERVER:8580
ExecStart=/usr/bin/python3 /opt/quartermaster/camera_helper.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
